OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png

# Shared secret for creating and approving imports. Required on Vercel.
WARDROBE_IMPORT_SECRET=

# BLOB_READ_WRITE_TOKEN comes from vercel env pull, which writes it to .env.local.
# Set WARDROBE_STORAGE=blob to run the dev server against Vercel Blob instead of data/.
