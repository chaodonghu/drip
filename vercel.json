{
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "query",
          "key": "piece"
        }
      ],
      "dest": "/api/share"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/import/(.*)",
      "dest": "/api/index"
    }
  ]
}
