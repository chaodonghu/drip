{
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "piece"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/api/import/:path*",
      "destination": "/api/index"
    }
  ]
}
